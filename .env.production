# 生产环境配置模板：占位符必须替换为强随机值，绝不提交真实密钥
NODE_ENV=production

# 数据库
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_DATABASE=
# 生产环境必须为 false：表结构只能走迁移
DB_SYNCHRONIZE=false

# MinIO
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_DEFAULT_BUCKET=bookkeeping

# JWT（生产必须换成强随机值）
JWT_SECRET=
JWT_EXPIRED=1d
FILE_SECRET=
FILE_TOKEN_EXPIRED=1d
REFRESH_SECRET=
REFRESH_TOKEN_EXPIRED=30d

# 接口限流
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# AI 代理（服务端持有密钥，客户端不再保存）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
