NODE_ENV=development

# 数据库
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_DATABASE=
# 表结构同步方式：false = 只走 migration（生产必须 false）；true = 启动时按实体自动改表（仅限本地调试）
DB_SYNCHRONIZE=false

# MinIO
MINIO_ENDPOINT=
MINIO_PORT=               # 端口
MINIO_USE_SSL=       # 是否使用 SSL
MINIO_ACCESS_KEY=         # 访问密钥
MINIO_SECRET_KEY=         # 密钥
MINIO_DEFAULT_BUCKET=     # 默认存储桶名称

# JWT
JWT_SECRET=123456
JWT_EXPIRED=1d
FILE_SECRET=123456
FILE_TOKEN_EXPIRED=1d
REFRESH_SECRET=123456
REFRESH_TOKEN_EXPIRED=30d

# 上传文件目录
UPLOAD_DIR=

# 接口限流（全局默认值；登录/注册接口单独收紧到 5 次/分钟，见 auth.controller）
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# AI 代理（服务端持有密钥，客户端通过 /v1/ai/* 调用）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
